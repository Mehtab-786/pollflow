generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ENUMS

enum ResponseMode {
  AUTHENTICATED
  ANONYMOUS
}

enum PollType {
  POLL
  QUIZ
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
}

enum SelectionMode {
  SINGLE
  MULTIPLE
}


// USER

model User {
  id           String   @id @default(uuid())
  username     String   
  passwordHash String
  email        String   @unique
  tokenHash    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  polls        Poll[]
  responses    Response[]
}


// POLL

model Poll {
  id           String       @id @default(uuid())
  title        String

  creatorId    String
  responseMode ResponseMode
  expiresAt    DateTime?
  isPublished  Boolean      @default(false)
  type         PollType

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  creator      User         @relation(fields: [creatorId], references: [id])
  questions    Question[]
  responses    Response[]

  @@index([creatorId])
}


// QUESTION

model Question {
  id            String        @id @default(uuid())
  question      String
  position      Int
  pollId        String

  isRequired    Boolean
  type          QuestionType
  selectionMode SelectionMode

  createdAt     DateTime      @default(now())

  poll          Poll          @relation(fields: [pollId], references: [id], onDelete: Cascade)
  options       Option[]
  answers       ResponseAnswer[]


  @@unique([pollId, position])
  @@index([pollId])
}


// OPTION

model Option {
  id         String          @id @default(uuid())
  text       String
  questionId String

  createdAt  DateTime        @default(now())

  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    ResponseAnswer[]

  @@index([questionId])
}


// RESPONSE

model Response {
  id           String           @id @default(uuid())
  respondentId String?
  pollId       String

  createdAt    DateTime         @default(now())

  respondent   User?            @relation(fields: [respondentId], references: [id])
  poll         Poll             @relation(fields: [pollId], references: [id], onDelete: Cascade)
  answers      ResponseAnswer[]

  @@index([pollId])
  @@index([respondentId])
}


// RESPONSE ANSWER

model ResponseAnswer {
  id         String    @id @default(uuid())
  responseId String
  questionId String
  optionId   String?

  createdAt  DateTime  @default(now())

  response   Response  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   Question  @relation(fields: [questionId], references: [id])
  option     Option?   @relation(fields: [optionId], references: [id])

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}
